# Alchemy Sepolia RPC URL (get from https://alchemy.com)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Wallet private key (for deployment) — get from MetaMask or new wallet
